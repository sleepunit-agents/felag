{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://felag.dev/schema/felag-core/1.1.0/schema.json",
  "title": "felag-core interchange records (conformanceVersion 1.1.0)",
  "description": "Schema for the records of spec.jsonl and fixtures.jsonl, plus the verification-side objects (VerificationRecord, Waiver, ConformanceReport) and the tool result objects used by fixtures. Each JSONL line validates against #/$defs/record. Canonical serialization (CS1-CS9) is specified in spec item it-interchange and is a conformance requirement on writers, not expressible in JSON Schema.",
  "$defs": {
    "record": {
      "oneOf": [
        {"$ref": "#/$defs/preamble"},
        {"$ref": "#/$defs/item"},
        {"$ref": "#/$defs/criterion"},
        {"$ref": "#/$defs/fixture"}
      ]
    },
    "id": {"type": "string", "minLength": 1},
    "attribution": {
      "type": "string",
      "description": "Free-form attribution string with no semantics; implementers MUST NOT build behavior on its value."
    },
    "timestamp": {"type": "string", "format": "date-time"},
    "preamble": {
      "type": "object",
      "properties": {
        "record": {"const": "preamble"},
        "name": {"type": "string", "minLength": 1},
        "conformanceVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "goals": {"type": "array", "items": {"type": "string"}},
        "contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {"id": {"$ref": "#/$defs/id"}, "description": {"type": "string"}},
            "required": ["id", "description"],
            "additionalProperties": false
          }
        },
        "exclusions": {"type": "array", "items": {"type": "string"}},
        "governance": {
          "type": "object",
          "description": "Committed governance parameters (1.0.0). The roster's declared timeout; default {timeoutDays: 30} when the field is absent.",
          "properties": {"timeoutDays": {"type": "integer", "minimum": 1}},
          "required": ["timeoutDays"],
          "additionalProperties": false
        },
        "implementers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "roles": {"type": "array", "items": {"type": "string"}, "minItems": 1}
            },
            "required": ["name", "roles"],
            "additionalProperties": false
          }
        }
      },
      "required": ["record", "name", "conformanceVersion", "goals", "contracts", "implementers"],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "properties": {
        "record": {"const": "item"},
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "body": {"type": "string"},
        "interfaceSketch": {
          "type": "string",
          "description": "Optional, non-normative illustration of an interface shape; never gates, carries no conformance meaning."
        }
      },
      "required": ["record", "id", "title", "body"],
      "additionalProperties": false
    },
    "criterion": {
      "type": "object",
      "properties": {
        "record": {"const": "criterion"},
        "id": {"$ref": "#/$defs/id"},
        "itemId": {"$ref": "#/$defs/id"},
        "contractId": {"$ref": "#/$defs/id"},
        "type": {"enum": ["scenario", "checklist"]},
        "class": {"enum": ["behavioral", "judgment"]},
        "gherkin": {"type": "string"},
        "item": {"type": "string"},
        "force": {"enum": ["MUST", "SHOULD", "MAY"]},
        "state": {"enum": ["proposed", "active", "deprecated", "disputed"]},
        "source": {"enum": ["forethought", "discovered"]},
        "discoveredAt": {"$ref": "#/$defs/timestamp"},
        "discoveredBy": {"$ref": "#/$defs/attribution"},
        "triggeringEvent": {"type": "string"},
        "fixtures": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "dispute": {
          "type": "object",
          "description": "Required when state is disputed; 'by' names the roster implementer whose conformance reports stop gating on this criterion.",
          "properties": {
            "by": {"type": "string", "minLength": 1},
            "reason": {"type": "string"},
            "at": {"$ref": "#/$defs/timestamp"}
          },
          "required": ["by", "reason", "at"],
          "additionalProperties": false
        },
        "judgment": {
          "type": "object",
          "description": "Required if judgment-class gating is ever requested (no graduation bar exists at 0.1.0).",
          "properties": {
            "rubric": {"type": "string"},
            "judgeConfig": {"type": "string"},
            "reproducibility": {"type": "string"}
          },
          "required": ["rubric", "judgeConfig", "reproducibility"],
          "additionalProperties": false
        }
      },
      "required": ["record", "id", "itemId", "type", "class", "force", "state", "source", "fixtures"],
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"type": {"const": "scenario"}}}, "then": {"required": ["gherkin"]}},
        {"if": {"properties": {"type": {"const": "checklist"}}}, "then": {"required": ["item"]}},
        {"if": {"properties": {"state": {"const": "disputed"}}}, "then": {"required": ["dispute"]}}
      ]
    },
    "fixture": {
      "type": "object",
      "properties": {
        "record": {"const": "fixture"},
        "id": {"$ref": "#/$defs/id"},
        "contractId": {
          "$ref": "#/$defs/id",
          "description": "Optional since 0.2.0; when present it must name a contract declared in the preamble. A fixture without contractId carries no gating surface of its own but lets advisory (contract-less) criteria reference fixtures voluntarily."
        },
        "description": {"type": "string"},
        "format": {"type": "string", "minLength": 1},
        "input": {},
        "expected": {}
      },
      "required": ["record", "id", "description", "format", "input", "expected"],
      "additionalProperties": false
    },
    "verificationRecord": {
      "type": "object",
      "properties": {
        "criterionId": {"$ref": "#/$defs/id"},
        "fixtureId": {"$ref": "#/$defs/id"},
        "fixtureHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "implementation": {"type": "string", "minLength": 1},
        "implementationVersion": {"type": "string", "minLength": 1},
        "conformanceVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "verdict": {"enum": ["pass", "fail", "unverifiable"]},
        "evidence": {"type": "string"},
        "runner": {"type": "string"},
        "at": {"$ref": "#/$defs/timestamp"},
        "attribution": {"$ref": "#/$defs/attribution"}
      },
      "required": ["criterionId", "implementation", "implementationVersion", "conformanceVersion", "verdict", "evidence", "runner", "at", "attribution"],
      "additionalProperties": false
    },
    "waiver": {
      "type": "object",
      "properties": {
        "criterionId": {"$ref": "#/$defs/id"},
        "implementation": {"type": "string", "minLength": 1},
        "kind": {"enum": ["waiver", "known-bug"]},
        "justification": {"type": "string", "minLength": 1},
        "attribution": {"$ref": "#/$defs/attribution"},
        "expiresAt": {"$ref": "#/$defs/timestamp"}
      },
      "required": ["criterionId", "implementation", "kind", "justification", "attribution", "expiresAt"],
      "additionalProperties": false
    },
    "conformanceReport": {
      "type": "object",
      "properties": {
        "implementation": {"type": "string"},
        "conformanceVersion": {"type": "string"},
        "verdict": {"enum": ["conforms", "conforms-with-waivers", "drifts"]},
        "failing": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "waived": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "disputed": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "advisory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterionId": {"$ref": "#/$defs/id"},
              "verdict": {"enum": ["pass", "fail", "unverifiable"]}
            },
            "required": ["criterionId", "verdict"],
            "additionalProperties": false
          }
        }
      },
      "required": ["implementation", "conformanceVersion", "verdict", "failing", "waived", "disputed", "advisory"],
      "additionalProperties": false
    },
    "lintResult": {
      "type": "object",
      "properties": {
        "valid": {"type": "boolean"},
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {"enum": ["E_SCHEMA", "E_DUPLICATE_ID", "E_UNDECLARED_CONTRACT", "E_MISSING_FIXTURES", "E_UNKNOWN_FIXTURE", "E_DUPLICATE_IMPLEMENTER", "E_MULTIPLE_OWNERS"]},
              "ref": {"type": "string"}
            },
            "required": ["code", "ref"],
            "additionalProperties": false
          }
        }
      },
      "required": ["valid", "errors"],
      "additionalProperties": false
    },
    "ingestResult": {
      "type": "object",
      "properties": {
        "accepted": {"type": "boolean"},
        "errors": {
          "type": "array",
          "items": {"enum": ["E_SCHEMA", "E_MISSING_FIELD", "E_BAD_VERDICT"]}
        }
      },
      "required": ["accepted", "errors"],
      "additionalProperties": false
    },
    "acknowledgment": {
      "type": "object",
      "description": "A roster implementer's endorsement of a promotion transition, bound by criterionHash (CS9) to the criterion text as acknowledged — the staleness guard fixtureHash provides for VerificationRecords.",
      "properties": {
        "implementer": {"type": "string", "minLength": 1},
        "decision": {"enum": ["ack", "nak"]},
        "at": {"$ref": "#/$defs/timestamp"},
        "criterionHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "required": ["implementer", "decision", "at", "criterionHash"],
      "additionalProperties": false
    },
    "promotionInput": {
      "type": "object",
      "description": "felag/promotion-input@0: ratification as a pure function of (spec, transition, asOf); governance parameters are committed in the spec's preamble.",
      "properties": {
        "asOf": {"$ref": "#/$defs/timestamp"},
        "spec": {"type": "array", "items": {"$ref": "#/$defs/record"}},
        "transition": {
          "type": "object",
          "properties": {
            "criterionId": {"$ref": "#/$defs/id"},
            "to": {"enum": ["active", "rejected", "known-bug"]},
            "requestedAt": {"$ref": "#/$defs/timestamp"},
            "requestedBy": {"type": "string", "minLength": 1},
            "implementation": {"type": "string", "minLength": 1, "description": "known-bug only; opaque implementation name, NOT roster-validated"},
            "justification": {"type": "string", "minLength": 1},
            "expiresAt": {"$ref": "#/$defs/timestamp"},
            "attribution": {"$ref": "#/$defs/attribution"},
            "acknowledgments": {"type": "array", "items": {"$ref": "#/$defs/acknowledgment"}}
          },
          "required": ["criterionId", "to", "requestedAt", "requestedBy", "acknowledgments"],
          "additionalProperties": false
        }
      },
      "required": ["asOf", "spec", "transition"],
      "additionalProperties": false
    },
    "promotionResult": {
      "type": "object",
      "description": "felag/promotion-result@0: errors is the sorted set of ALL holding predicates (all-applicable; E_VETOED and E_PENDING co-fire); lapsed and stale are loud, sorted ascending.",
      "properties": {
        "accepted": {"type": "boolean"},
        "errors": {
          "type": "array",
          "items": {"enum": ["E_SCHEMA", "E_SPEC_INVALID", "E_UNKNOWN_CRITERION", "E_NOT_PROPOSED", "E_BAD_REQUEST", "E_NOT_ROSTER", "E_BAD_ACK", "E_MISSING_FIELD", "E_VETOED", "E_PENDING"]}
        },
        "outcome": {"enum": ["ratified", "rejected", null]},
        "lapsed": {"type": "array", "items": {"type": "string"}},
        "stale": {"type": "array", "items": {"type": "string"}},
        "waiver": {"oneOf": [{"$ref": "#/$defs/waiver"}, {"type": "null"}]}
      },
      "required": ["accepted", "errors", "outcome", "lapsed", "stale", "waiver"],
      "additionalProperties": false
    },
    "authorOutputInput": {
      "type": "object",
      "description": "felag/author-output@0: the complete post-interview record set; new lists the criteria this interview authored; budgets defaults to {criteriaPerItem: 7} when absent — the default is pinned here, not in any spec record.",
      "properties": {
        "spec": {"type": "array", "items": {"$ref": "#/$defs/record"}},
        "new": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "budgets": {
          "type": "object",
          "properties": {"criteriaPerItem": {"type": "integer", "minimum": 1}},
          "required": ["criteriaPerItem"],
          "additionalProperties": false
        }
      },
      "required": ["spec", "new"],
      "additionalProperties": false
    },
    "authorResult": {
      "type": "object",
      "description": "Lint-shaped; code enum is the union of lint codes and the author-output codes.",
      "properties": {
        "valid": {"type": "boolean"},
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {"enum": ["E_SCHEMA", "E_DUPLICATE_ID", "E_UNDECLARED_CONTRACT", "E_MISSING_FIXTURES", "E_UNKNOWN_FIXTURE", "E_DUPLICATE_IMPLEMENTER", "E_MULTIPLE_OWNERS", "E_BUDGET_CRITERIA", "E_BAD_PROVENANCE", "E_UNKNOWN_CRITERION"]},
              "ref": {"type": "string"}
            },
            "required": ["code", "ref"],
            "additionalProperties": false
          }
        }
      },
      "required": ["valid", "errors"],
      "additionalProperties": false
    },
    "excavateOutputInput": {
      "type": "object",
      "description": "felag/excavate-output@0: scope is required non-empty (X1); felag checks the artifact, not the archaeology.",
      "properties": {
        "scope": {
          "oneOf": [
            {
              "type": "object",
              "properties": {"contracts": {"type": "array", "items": {"$ref": "#/$defs/id"}}},
              "required": ["contracts"],
              "additionalProperties": false
            },
            {"type": "null"}
          ]
        },
        "spec": {"type": "array", "items": {"$ref": "#/$defs/record"}}
      },
      "required": ["scope", "spec"],
      "additionalProperties": false
    },
    "excavateResult": {
      "type": "object",
      "description": "Lint-shaped; code enum is the union of lint codes and the excavate-output codes.",
      "properties": {
        "valid": {"type": "boolean"},
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {"enum": ["E_SCHEMA", "E_DUPLICATE_ID", "E_UNDECLARED_CONTRACT", "E_MISSING_FIXTURES", "E_UNKNOWN_FIXTURE", "E_DUPLICATE_IMPLEMENTER", "E_MULTIPLE_OWNERS", "E_NO_SCOPE", "E_BAD_PROVENANCE", "E_OUT_OF_SCOPE"]},
              "ref": {"type": "string"}
            },
            "required": ["code", "ref"],
            "additionalProperties": false
          }
        }
      },
      "required": ["valid", "errors"],
      "additionalProperties": false
    },
    "renderInventoryInput": {
      "type": "object",
      "description": "felag/render-inventory@0: audience projection — what each audience sees, never typesetting.",
      "properties": {
        "spec": {"type": "array", "items": {"$ref": "#/$defs/record"}},
        "audience": {"enum": ["stakeholder", "developer", "verifier"]}
      },
      "required": ["spec", "audience"],
      "additionalProperties": false
    },
    "renderInventory": {
      "type": "object",
      "description": "Both fields are EXACT sets, sorted ascending — equality-checked, not subset. included ranges over id-bearing records; the preamble has no id and is included for every audience by definition.",
      "properties": {
        "included": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "excludedFields": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["included", "excludedFields"],
      "additionalProperties": false
    },
    "primeOutputInput": {
      "type": "object",
      "description": "felag/prime-output@0: the emitted document must contain, verbatim, the body of every protocol item — an item with at least one criterion whose contractId is c-author.",
      "properties": {
        "spec": {"type": "array", "items": {"$ref": "#/$defs/record"}},
        "output": {"type": "string"}
      },
      "required": ["spec", "output"],
      "additionalProperties": false
    },
    "primeResult": {
      "type": "object",
      "properties": {
        "valid": {"type": "boolean"},
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {"enum": ["E_MISSING_PROTOCOL"]},
              "ref": {"type": "string"}
            },
            "required": ["code", "ref"],
            "additionalProperties": false
          }
        }
      },
      "required": ["valid", "errors"],
      "additionalProperties": false
    },
    "verifyInput": {
      "type": "object",
      "description": "Fixture exchange format felag/verify-input@0: the inputs of verdict derivation made deterministic (asOf pins waiver expiry evaluation).",
      "properties": {
        "asOf": {"$ref": "#/$defs/timestamp"},
        "implementation": {"type": "string"},
        "records": {"type": "array", "items": {"$ref": "#/$defs/verificationRecord"}},
        "spec": {"type": "array", "items": {"$ref": "#/$defs/record"}},
        "waivers": {"type": "array", "items": {"$ref": "#/$defs/waiver"}}
      },
      "required": ["asOf", "implementation", "records", "spec", "waivers"],
      "additionalProperties": false
    }
  }
}
