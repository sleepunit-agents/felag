{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://felag.dev/schema/felag-core/0.1.0/schema.json",
  "title": "felag-core interchange records (conformanceVersion 0.1.0)",
  "description": "Schema for the records of spec.jsonl and fixtures.jsonl, plus the verification-side objects (VerificationRecord, Waiver, ConformanceReport) and the tool result objects used by fixtures. Each JSONL line validates against #/$defs/record. Canonical serialization (CS1-CS9) is specified in spec item it-interchange and is a conformance requirement on writers, not expressible in JSON Schema.",
  "$defs": {
    "record": {
      "oneOf": [
        {"$ref": "#/$defs/preamble"},
        {"$ref": "#/$defs/item"},
        {"$ref": "#/$defs/criterion"},
        {"$ref": "#/$defs/fixture"}
      ]
    },
    "id": {"type": "string", "minLength": 1},
    "attribution": {
      "type": "string",
      "description": "Free-form attribution string with no semantics; implementers MUST NOT build behavior on its value."
    },
    "timestamp": {"type": "string", "format": "date-time"},
    "preamble": {
      "type": "object",
      "properties": {
        "record": {"const": "preamble"},
        "name": {"type": "string", "minLength": 1},
        "conformanceVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "goals": {"type": "array", "items": {"type": "string"}},
        "contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {"id": {"$ref": "#/$defs/id"}, "description": {"type": "string"}},
            "required": ["id", "description"],
            "additionalProperties": false
          }
        },
        "exclusions": {"type": "array", "items": {"type": "string"}},
        "implementers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "roles": {"type": "array", "items": {"type": "string"}, "minItems": 1}
            },
            "required": ["name", "roles"],
            "additionalProperties": false
          }
        }
      },
      "required": ["record", "name", "conformanceVersion", "goals", "contracts", "implementers"],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "properties": {
        "record": {"const": "item"},
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "body": {"type": "string"},
        "interfaceSketch": {
          "type": "string",
          "description": "Optional, non-normative illustration of an interface shape; never gates, carries no conformance meaning."
        }
      },
      "required": ["record", "id", "title", "body"],
      "additionalProperties": false
    },
    "criterion": {
      "type": "object",
      "properties": {
        "record": {"const": "criterion"},
        "id": {"$ref": "#/$defs/id"},
        "itemId": {"$ref": "#/$defs/id"},
        "contractId": {"$ref": "#/$defs/id"},
        "type": {"enum": ["scenario", "checklist"]},
        "class": {"enum": ["behavioral", "judgment"]},
        "gherkin": {"type": "string"},
        "item": {"type": "string"},
        "force": {"enum": ["MUST", "SHOULD", "MAY"]},
        "state": {"enum": ["proposed", "active", "deprecated", "disputed"]},
        "source": {"enum": ["forethought", "discovered"]},
        "discoveredAt": {"$ref": "#/$defs/timestamp"},
        "discoveredBy": {"$ref": "#/$defs/attribution"},
        "triggeringEvent": {"type": "string"},
        "fixtures": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "dispute": {
          "type": "object",
          "description": "Required when state is disputed; 'by' names the roster implementer whose conformance reports stop gating on this criterion.",
          "properties": {
            "by": {"type": "string", "minLength": 1},
            "reason": {"type": "string"},
            "at": {"$ref": "#/$defs/timestamp"}
          },
          "required": ["by", "reason", "at"],
          "additionalProperties": false
        },
        "judgment": {
          "type": "object",
          "description": "Required if judgment-class gating is ever requested (no graduation bar exists at 0.1.0).",
          "properties": {
            "rubric": {"type": "string"},
            "judgeConfig": {"type": "string"},
            "reproducibility": {"type": "string"}
          },
          "required": ["rubric", "judgeConfig", "reproducibility"],
          "additionalProperties": false
        }
      },
      "required": ["record", "id", "itemId", "type", "class", "force", "state", "source", "fixtures"],
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"type": {"const": "scenario"}}}, "then": {"required": ["gherkin"]}},
        {"if": {"properties": {"type": {"const": "checklist"}}}, "then": {"required": ["item"]}},
        {"if": {"properties": {"state": {"const": "disputed"}}}, "then": {"required": ["dispute"]}}
      ]
    },
    "fixture": {
      "type": "object",
      "properties": {
        "record": {"const": "fixture"},
        "id": {"$ref": "#/$defs/id"},
        "contractId": {"$ref": "#/$defs/id"},
        "description": {"type": "string"},
        "format": {"type": "string", "minLength": 1},
        "input": {},
        "expected": {}
      },
      "required": ["record", "id", "contractId", "description", "format", "input", "expected"],
      "additionalProperties": false
    },
    "verificationRecord": {
      "type": "object",
      "properties": {
        "criterionId": {"$ref": "#/$defs/id"},
        "fixtureId": {"$ref": "#/$defs/id"},
        "fixtureHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "implementation": {"type": "string", "minLength": 1},
        "implementationVersion": {"type": "string", "minLength": 1},
        "conformanceVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "verdict": {"enum": ["pass", "fail", "unverifiable"]},
        "evidence": {"type": "string"},
        "runner": {"type": "string"},
        "at": {"$ref": "#/$defs/timestamp"},
        "attribution": {"$ref": "#/$defs/attribution"}
      },
      "required": ["criterionId", "implementation", "implementationVersion", "conformanceVersion", "verdict", "evidence", "runner", "at", "attribution"],
      "additionalProperties": false
    },
    "waiver": {
      "type": "object",
      "properties": {
        "criterionId": {"$ref": "#/$defs/id"},
        "implementation": {"type": "string", "minLength": 1},
        "kind": {"enum": ["waiver", "known-bug"]},
        "justification": {"type": "string", "minLength": 1},
        "attribution": {"$ref": "#/$defs/attribution"},
        "expiresAt": {"$ref": "#/$defs/timestamp"}
      },
      "required": ["criterionId", "implementation", "kind", "justification", "attribution", "expiresAt"],
      "additionalProperties": false
    },
    "conformanceReport": {
      "type": "object",
      "properties": {
        "implementation": {"type": "string"},
        "conformanceVersion": {"type": "string"},
        "verdict": {"enum": ["conforms", "conforms-with-waivers", "drifts"]},
        "failing": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "waived": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "disputed": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "advisory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterionId": {"$ref": "#/$defs/id"},
              "verdict": {"enum": ["pass", "fail", "unverifiable"]}
            },
            "required": ["criterionId", "verdict"],
            "additionalProperties": false
          }
        }
      },
      "required": ["implementation", "conformanceVersion", "verdict", "failing", "waived", "disputed", "advisory"],
      "additionalProperties": false
    },
    "lintResult": {
      "type": "object",
      "properties": {
        "valid": {"type": "boolean"},
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {"enum": ["E_SCHEMA", "E_DUPLICATE_ID", "E_UNDECLARED_CONTRACT", "E_MISSING_FIXTURES", "E_UNKNOWN_FIXTURE"]},
              "ref": {"type": "string"}
            },
            "required": ["code", "ref"],
            "additionalProperties": false
          }
        }
      },
      "required": ["valid", "errors"],
      "additionalProperties": false
    },
    "ingestResult": {
      "type": "object",
      "properties": {
        "accepted": {"type": "boolean"},
        "errors": {
          "type": "array",
          "items": {"enum": ["E_SCHEMA", "E_MISSING_FIELD", "E_BAD_VERDICT"]}
        }
      },
      "required": ["accepted", "errors"],
      "additionalProperties": false
    },
    "verifyInput": {
      "type": "object",
      "description": "Fixture exchange format felag/verify-input@0: the inputs of verdict derivation made deterministic (asOf pins waiver expiry evaluation).",
      "properties": {
        "asOf": {"$ref": "#/$defs/timestamp"},
        "implementation": {"type": "string"},
        "records": {"type": "array", "items": {"$ref": "#/$defs/verificationRecord"}},
        "spec": {"type": "array", "items": {"$ref": "#/$defs/record"}},
        "waivers": {"type": "array", "items": {"$ref": "#/$defs/waiver"}}
      },
      "required": ["asOf", "implementation", "records", "spec", "waivers"],
      "additionalProperties": false
    }
  }
}
